[Unit]
Description=Monitor de tareas EVA a Telegram
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=eva-telegram
Group=eva-telegram
WorkingDirectory=/opt/eva-telegram
EnvironmentFile=/etc/eva-telegram/eva-telegram.env
ExecStart=/opt/eva-telegram/.venv/bin/python -u src/check_eva.py run
Restart=on-failure
RestartSec=15

# Endurecimiento básico: el código queda de solo lectura y únicamente
# /var/lib/eva-telegram puede recibir estado y cookies.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/eva-telegram

[Install]
WantedBy=multi-user.target
